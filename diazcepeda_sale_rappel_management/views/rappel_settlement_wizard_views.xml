<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- =====================================================================
         RAPPEL SETTLEMENT WIZARD – Form view
    ====================================================================== -->
    <record id="view_rappel_settlement_wizard_form" model="ir.ui.view">
        <field name="name">rappel.settlement.wizard.form</field>
        <field name="model">rappel.settlement.wizard</field>
        <field name="arch" type="xml">
            <form string="Calcular Liquidación de Rappel">
                <group string="Filtros de Liquidación">
                    <group>
                        <field name="partner_id"/>
                        <field name="date_start"/>
                        <field name="date_end"/>
                    </group>
                    <group string="Filtros Opcionales">
                        <field name="product_id"
                               help="Si se indica, solo se liquidará este producto"/>
                        <field name="product_category_id"
                               help="Si se indica, solo se liquidarán productos de esta categoría"
                               invisible="product_id != False"/>
                        <field name="generate_credit_note"/>
                    </group>
                </group>
                <div class="alert alert-info" role="alert">
                    <strong>Información:</strong>
                    <ul>
                        <li>Solo se incluyen facturas <strong>confirmadas (publicadas)</strong>
                            en el período seleccionado.</li>
                        <li>Las líneas de factura ya incluidas en una liquidación anterior
                            serán <strong>excluidas automáticamente</strong>.</li>
                        <li>Solo se procesan productos con <strong>"Aplica Rappel"</strong>
                            activo en su ficha.</li>
                    </ul>
                </div>
                <footer>
                    <button name="action_calculate"
                            string="Calcular Liquidación"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

