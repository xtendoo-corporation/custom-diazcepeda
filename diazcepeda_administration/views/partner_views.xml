<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Heredar la vista tree de res.partner para añadir el campo ref -->
    <!-- Odoo 18: la vista base usa complete_name (no display_name) y <list> en vez de <tree> -->
    <record id="view_partner_tree_inherit_ref" model="ir.ui.view">
        <field name="name">res.partner.tree.ref</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="arch" type="xml">
            <field name="complete_name" position="after">
                <field name="ref"/>
            </field>
        </field>
    </record>

    <!-- Añadir el campo ref a las búsquedas -->
    <record id="view_res_partner_filter_inherit_ref" model="ir.ui.view">
        <field name="name">res.partner.search.ref</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <!-- Añadir el campo ref como campo de búsqueda visible -->
            <field name="name" position="after">
                <field name="ref" string="Referencia"/>
            </field>
        </field>
    </record>
</odoo>
