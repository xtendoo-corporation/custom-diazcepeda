<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="paperformat_invoice_compact" model="report.paperformat">
        <field name="name">Formato Papel Factura Compacto</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">38</field>
        <field name="margin_bottom">20</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_spacing">48</field>
        <field name="dpi">90</field>
        <field name="css_margins" eval="True" />
        <field name="header_line" eval="False" />
    </record>

    <record id="account.account_invoices" model="ir.actions.report">
        <field
      name="paperformat_id"
      ref="diazcepeda_document_format.paperformat_invoice_compact"
    />
    </record>

    <record id="account.account_invoices_without_payment" model="ir.actions.report">
        <field
      name="paperformat_id"
      ref="diazcepeda_document_format.paperformat_invoice_compact"
    />
    </record>

    <record id="account_invoices_copy" model="ir.actions.report">
        <field
      name="paperformat_id"
      ref="diazcepeda_document_format.paperformat_invoice_compact"
    />
    </record>
</odoo>
