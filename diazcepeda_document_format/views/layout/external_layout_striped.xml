<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Plantilla para facturas -->
    <template id="report_invoice_document_inherit_vacation" inherit_id="account.report_invoice_document">
        <xpath expr="//h2" position="replace">
            <table class="table table-sm mt-2 mb-3" style="border: none;">
                <tr>
                    <td class="text-left" style="border: none;">
                        <h2>
                            <t t-if="o.state == 'draft'">
                                <span style="font-weight: normal;">Borrador de Factura: </span>
                            </t>
                            <t t-elif="o.move_type == 'out_refund'">
                                <span style="font-weight: normal;">Factura Rectificativa: </span>
                            </t>
                            <t t-elif="o.move_type == 'in_invoice'">
                                <span style="font-weight: normal;">Factura de Proveedor: </span>
                            </t>
                            <t t-else="">
                                <span style="font-weight: normal;">Factura: </span>
                            </t>
                            <span t-field="o.name"/>
                        </h2>
                    </td>
                    <td class="text-right" style="border: none;">
                        <div class="text-muted">
                            <span>
                                <strong t-esc="env['ir.config_parameter'].sudo().get_param('diazcepeda.vacation')"/>
                            </span>
                        </div>
                    </td>
                </tr>
            </table>
        </xpath>
    </template>

    <!-- Plantilla para pedidos de venta -->
    <template id="report_saleorder_document_inherit_vacation" inherit_id="sale.report_saleorder_document">
        <xpath expr="//h2" position="replace">
            <table class="table table-sm mt-2 mb-3" style="border: none;">
                <tr>
                    <td class="text-left" style="border: none;">
                        <h2>
                            <t t-if="doc.state in ('draft', 'sent')">
                                <span style="font-weight: normal;">Presupuesto: </span>
                            </t>
                            <t t-else="">
                                <span style="font-weight: normal;">Pedido: </span>
                            </t>
                            <span t-field="doc.name"/>
                        </h2>
                    </td>
                    <td class="text-right" style="border: none;">
                        <div class="text-muted">
                            <span>
                                <strong t-esc="env['ir.config_parameter'].sudo().get_param('diazcepeda.vacation')"/>
                            </span>
                        </div>
                    </td>
                </tr>
            </table>
        </xpath>
    </template>

    <!-- Plantilla para albaranes de entrega -->
    <template id="report_delivery_document_inherit_vacation" inherit_id="stock.report_delivery_document">
        <xpath expr="//h2" position="replace">
            <table class="table table-sm mt-2 mb-3" style="border: none;">
                <tr>
                    <td class="text-left" style="border: none;">
                        <h2>
                            <t t-if="o.state != 'done'">
                                <span style="font-weight: normal;">Borrador de Albarán: </span>
                            </t>
                            <t t-elif="o.picking_type_code == 'outgoing'">
                                <span style="font-weight: normal;">Albarán de Salida: </span>
                            </t>
                            <t t-elif="o.picking_type_code == 'incoming'">
                                <span style="font-weight: normal;">Albarán de Entrada: </span>
                            </t>
                            <t t-else="">
                                <span style="font-weight: normal;">Albarán: </span>
                            </t>
                            <span t-field="o.name"/>
                        </h2>
                    </td>
                    <td class="text-right" style="border: none;">
                        <div class="text-muted">
                            <span>
                                <strong t-esc="env['ir.config_parameter'].sudo().get_param('diazcepeda.vacation')"/>
                            </span>
                        </div>
                    </td>
                </tr>
            </table>
        </xpath>
    </template>
</odoo>
