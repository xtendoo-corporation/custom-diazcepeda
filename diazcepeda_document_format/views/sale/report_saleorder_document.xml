<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="report_saleorder_document_inherit" inherit_id="sale.report_saleorder_document">

        <!-- Odoo 18: ya no existe <h2> en este template; el título se define con
             t-set="layout_document_title" y lo renderiza web.external_layout -->
        <xpath expr="//t[@t-set='layout_document_title']" position="replace">
            <t t-set="layout_document_title">
                <span t-if="is_proforma">Factura Pro-Forma # </span>
                <span t-elif="doc.state in ['draft','sent']"><span style="font-weight: normal;">Presupuesto: </span></span>
                <span t-else=""><span style="font-weight: normal;">Pedido: </span></span>
                <span t-field="doc.name">SO0000</span>
            </t>
        </xpath>

        <!-- Parámetro de vacaciones reubicado: antes estaba junto al h2,
             ahora se añade antes del bloque de informaciones del pedido -->
        <xpath expr="//div[@id='informations']" position="before">
            <div class="text-muted text-end mb-2">
                <strong t-esc="env['ir.config_parameter'].sudo().get_param('diazcepeda.vacation')"/>
            </div>
        </xpath>

        <xpath expr="//th[@name='th_priceunit']" position="replace">
            <th name="th_priceunit" class="text-end">Precio</th>
        </xpath>
        <xpath expr="//th[@name='th_priceunit']" position="after">
            <th name="th_green_point" class="text-end" t-if="any(l.green_point_applicable for l in doc.order_line)">
                <span>P. V.</span>
            </th>
        </xpath>
        <xpath expr="//td[@name='td_priceunit']" position="after">
            <td name="td_green_point" class="text-end" t-if="any(k.green_point_applicable for k in doc.order_line)">
                <span t-if="line.green_point_applicable" t-field="line.green_point_amount_line"/>
            </td>
        </xpath>
        <xpath expr="//td[@name='td_quantity']" position="replace">
            <td name="td_quantity" class="text-end">
                <span t-field="line.product_uom_qty">3</span>
            </td>
        </xpath>
        <xpath expr="//span[@t-field='doc.note']" position="after">
            <t t-set="show_gastos_gestion" t-value="doc._is_gasto_gestion()"/>
        </xpath>
        <xpath expr="//span[@name='order_note']" position="after">
            <t t-if="is_copy == 2">
                <p style="font-weight:bolder;color:black;">*Este documento es una copia.</p>
            </t>
        </xpath>
        <xpath expr="//div[@name='so_total_summary']" position="after">
            <div style="margin-top:-60px;" id="left-elements" t-attf-class="#{'col-5' if report_type != 'html' else 'col-12 col-md-5'} ms-5 d-inline-block float-start">
                <t t-set="footer_data" t-value="doc._get_footer_data()"/>
                <div style="margin-left:-14%;">
                    <span t-out="footer_data"/>
                </div>
            </div>
        </xpath>
    </template>

    <!--Informe-->
    <record id="action_report_saleorder_copy" model="ir.actions.report">
        <field name="name">Presupuesto en PDF Copia</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">diazcepeda_document_format.report_saleorder_copy</field>
        <field name="report_file">diazcepeda_document_format.report_saleorder_raw</field>
        <field name="print_report_name">(object.state in ('draft', 'sent') and 'Quotation - %s' % (object.name)) or 'Order - %s' % (object.name)</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
    </record>
    <!--Fin Informe -->

    <template id="report_saleorder_copy">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="is_copy" t-value="2"/>
                <t t-call="sale.report_saleorder_document" t-lang="doc.partner_id.lang"/>
            </t>
        </t>
    </template>
</odoo>
