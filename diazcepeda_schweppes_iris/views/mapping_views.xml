<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_schweppes" model="ir.ui.view">
        <field name="name">res.partner.form.schweppes</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Schweppes IRIS" name="schweppes_iris">
                    <group>
                        <group>
                            <field name="schweppes_customer_code"/>
                            <field name="schweppes_delivery_type"/>
                            <field name="schweppes_route"/>
                        </group>
                    </group>
                </page>
            </notebook>
        </field>
    </record>

    <record id="product_template_form_view_schweppes" model="ir.ui.view">
        <field name="name">product.template.form.schweppes</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="schweppes_product_code"/>
            </xpath>
        </field>
    </record>
    <!-- Mapping Shortcuts -->
    <record id="action_schweppes_product_mapping" model="ir.actions.act_window">
        <field name="name">Mapeo de Productos Schweppes</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{'search_default_filter_to_sell': 1}</field>
        <field name="view_id" ref="product.product_template_tree_view"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configure aquí los códigos de sus productos Schweppes.
            </p>
        </field>
    </record>

    <record id="action_schweppes_partner_mapping" model="ir.actions.act_window">
        <field name="name">Mapeo de Clientes Schweppes</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">{'search_default_customer': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configure aquí los códigos y rutas de sus clientes para IRIS.
            </p>
        </field>
    </record>

    <menuitem id="menu_schweppes_mapping_root" name="Mapeos Maestro" parent="menu_schweppes_iris_root" sequence="20"/>
    <menuitem id="menu_schweppes_product_mapping" name="Productos" parent="menu_schweppes_mapping_root" action="action_schweppes_product_mapping" sequence="10"/>
    <menuitem id="menu_schweppes_partner_mapping" name="Clientes" parent="menu_schweppes_mapping_root" action="action_schweppes_partner_mapping" sequence="20"/>
</odoo>
