<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_schweppes_iris_export_form" model="ir.ui.view">
        <field name="name">schweppes.iris.export.form</field>
        <field name="model">schweppes.iris.export</field>
        <field name="arch" type="xml">
            <form string="Exportar Schweppes IRIS">
                <header>
                    <button name="action_load_export_lines" string="Cargar / Recargar Líneas" type="object" class="btn-secondary" invisible="state == 'sent' or file_data"/>
                    <button name="action_generate_file" string="Generar Fichero" type="object" class="oe_highlight" invisible="state == 'sent' or file_data"/>
                    <button name="action_delete_file" string="Eliminar Fichero y Editar" type="object" class="btn-secondary" invisible="not file_data or state == 'sent'"/>
                    <button name="action_preview_file" string="Previsualizar" type="object" class="btn-primary" invisible="line_count == 0"/>
                    <button name="action_send_file" string="Enviar" type="object" class="oe_highlight" invisible="not file_data or state != 'generated'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,generated,sent"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <field name="date_from" readonly="state == 'sent' or file_data"/>
                        <field name="date_to" readonly="state == 'sent' or file_data"/>
                        <field name="company_id" groups="base.group_multi_company" readonly="state == 'sent' or file_data"/>
                    </group>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_sale_orders" type="object" class="oe_stat_button" icon="fa-pencil-square-o" invisible="sale_order_count == 0">
                            <field name="sale_order_count" string="Pedidos" widget="statinfo"/>
                        </button>
<!--                        <button name="action_view_sale_order_lines" type="object" class="oe_stat_button" icon="fa-list" invisible="line_count == 0">-->
<!--                            <field name="line_count" string="Líneas" widget="statinfo"/>-->
<!--                        </button>-->
                        <button name="action_view_partners" type="object" class="oe_stat_button" icon="fa-users" invisible="partner_count == 0">
                            <field name="partner_count" string="Clientes" widget="statinfo"/>
                        </button>
                    </div>
                    <notebook>
                         <page string="Líneas a exportar">
                        <field name="export_line_ids" nolabel="1" readonly="state == 'sent' or file_data">
                            <list editable="bottom" string="Líneas a exportar">
                                <field name="sequence" widget="handle"/>
                                <field name="sale_order_id"/>
                                <field name="sale_order_line_id" optional="hide"/>
                                <field name="partner_id"/>
                                <field name="product_id"/>
                                <field name="name" optional="show"/>
                                <field name="product_uom_qty"/>
                                <field name="price_unit"/>
                                <field name="discount"/>
                                <field name="discount_amount" readonly="1"/>
                                <field name="schweppes_product_code" readonly="1"/>
                            </list>
                        </field>
                    </page>
                        <page string="Archivo generado">
                            <group>
                                <field name="file_name" invisible="not file_name"/>
                                <field name="file_data" filename="file_name" invisible="not file_data"/>
                                <field name="line_count" invisible="state == 'draft'"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista lista (Odoo 18: <list> reemplaza a <tree>) -->
    <record id="view_schweppes_iris_export_tree" model="ir.ui.view">
        <field name="name">schweppes.iris.export.tree</field>
        <field name="model">schweppes.iris.export</field>
        <field name="arch" type="xml">
            <list string="Exportaciones Schweppes IRIS">
                <field name="name"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="sale_order_count"/>
                <field name="line_count"/>
                <field name="partner_count"/>
                <field name="state"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="action_schweppes_iris_export" model="ir.actions.act_window">
        <field name="name">Exportación Schweppes IRIS</field>
        <field name="res_model">schweppes.iris.export</field>
        <field name="view_mode">list,form</field>  <!-- Odoo 18: 'tree' → 'list' -->
    </record>

    <record id="view_schweppes_export_line_tree" model="ir.ui.view">
        <field name="name">schweppes.export.line.list</field>
        <field name="model">schweppes.export.line</field>
        <field name="arch" type="xml">
            <list string="Líneas de exportación Schweppes" create="false" delete="false">
                <field name="sale_order_id"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="name"/>
                <field name="product_uom_qty"/>
                <field name="price_unit"/>
                <field name="discount" string="Descuento"/>
                <field name="discount_amount"/>
                <field name="schweppes_product_code"/>
            </list>
        </field>
    </record>

    <record id="view_schweppes_export_line_form" model="ir.ui.view">
        <field name="name">schweppes.export.line.form</field>
        <field name="model">schweppes.export.line</field>
        <field name="arch" type="xml">
            <form string="Línea de exportación Schweppes">
                <sheet>
                    <group>
                        <field name="export_id" readonly="1"/>
                        <field name="sale_order_id"/>
                        <field name="sale_order_line_id"/>
                        <field name="partner_id"/>
                        <field name="product_id"/>
                <field name="name"/>
                        <field name="product_uom_qty"/>
                        <field name="price_unit"/>
                        <field name="discount"/>
                        <field name="discount_amount" readonly="1"/>
                        <field name="schweppes_product_code" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <menuitem id="menu_schweppes_iris_root" name="Schweppes IRIS" parent="diazcepeda_administration.menu_diazcepeda_config" sequence="100"/>
    <menuitem id="menu_schweppes_iris_export" name="Exportar líneas de pedidos de Schweppes Iris" parent="menu_schweppes_iris_root" action="action_schweppes_iris_export" sequence="10"/>

</odoo>
